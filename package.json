{
  "name": "aether-gravity",
  "private": true,
  "version": "2.0.0",
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-proguard.js",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "test": "vitest run",
    "lint:deadcode": "knip --exclude duplicates --no-config-hints",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "playwright test e2e/perf.spec.ts",
    "test:perf:soak": "playwright test e2e/perf.spec.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "android:manifest-gate": "node scripts/android-manifest-gate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "8.16.8",
    "@react-three/postprocessing": "2.16.2",
    "@visx/axis": "3.3.0",
    "@visx/curve": "3.3.0",
    "@visx/group": "3.3.0",
    "@visx/responsive": "3.3.0",
    "@visx/scale": "3.3.0",
    "@visx/shape": "3.3.0",
    "clsx": "2.1.1",
    "lucide-react": "0.395.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.3.0",
    "three": "0.165.0",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "knip": "6.37.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
